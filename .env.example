# ---- 数据库：Docker 自建 Postgres（compose 内的主机名是 db）----
# 应用容器用的连接串；docker compose 会用下面的 POSTGRES_* 覆盖它，一般不用改
DATABASE_URL=postgresql://debate:debate@db:5432/debate
# 服务器上务必换成强密码，并保证三处一致（db 服务 / 应用连接串 / 备份脚本）
POSTGRES_USER=debate
POSTGRES_PASSWORD=debate
POSTGRES_DB=debate

# ---- 镜像与端口 ----
# 本地留默认值（本地构建）；服务器填 CI 推到 ACR 的镜像地址
APP_IMAGE=debate-app:local
MIGRATE_IMAGE=debate-migrate:local
APP_PORT=3000
# 只绑定回环地址，供主机侧工具直连；公网访问不到
DB_PORT=5432

# 定时任务：UTC 几点推进挑战阶段（默认 03:00，与 vercel.json 一致）
CRON_HOUR_UTC=3

# Cron 调用密钥（route 内校验；未配置时接口返回 503，失败关闭）
CRON_SECRET=replace-with-a-long-random-string

# NextAuth（M1：GitHub OAuth，首次登录自动创建 users 档案）
# AUTH_SECRET 生成：openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# GitHub OAuth App（https://github.com/settings/developers → OAuth Apps）
# Homepage URL: http://localhost:3000（部署后换成正式域名）
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# M3 AI 程序检查（复述/查重/侮辱）：默认只跑本地启发式；
# 需要 LLM 增强时置 true 并填 OpenAI 兼容接口（未配置/失败自动降级为本地结果）。
# 示例（DeepSeek）：URL=https://api.deepseek.com/v1/chat/completions，MODEL=deepseek-v4-flash
AI_PROGRAM_LLM_ENABLED=false
AI_PROGRAM_LLM_URL=
AI_PROGRAM_LLM_API_KEY=
AI_PROGRAM_LLM_MODEL=gpt-4o-mini
