# Neon PostgreSQL 连接串（本地开发 / Vercel 各建一套）
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Cron 调用密钥（与 route 内校验一致）
CRON_SECRET=replace-with-a-long-random-string

# NextAuth（M1：GitHub OAuth，首次登录自动创建 users 档案）
# AUTH_SECRET 生成：openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# GitHub OAuth App（https://github.com/settings/developers → OAuth Apps）
# Homepage URL: http://localhost:3000（生产环境换成 Vercel 域名）
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
