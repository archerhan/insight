# Neon PostgreSQL 连接串（本地开发 / Vercel 各建一套）
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Cron 调用密钥（与 route 内校验一致）
CRON_SECRET=replace-with-a-long-random-string

# NextAuth（M1：GitHub OAuth，首次登录自动创建 users 档案）
# AUTH_SECRET 生成：openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# GitHub OAuth App（https://github.com/settings/developers → OAuth Apps）
# Homepage URL: http://localhost:3000（生产环境换成 Vercel 域名）
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# M3 AI 程序检查（复述/查重/侮辱）：默认只跑本地启发式；
# 需要 LLM 增强时置 true 并填 OpenAI 兼容接口（未配置/失败自动降级为本地结果）。
# 示例（DeepSeek）：URL=https://api.deepseek.com/v1/chat/completions，MODEL=deepseek-v4-flash
AI_PROGRAM_LLM_ENABLED=false
AI_PROGRAM_LLM_URL=
AI_PROGRAM_LLM_API_KEY=
AI_PROGRAM_LLM_MODEL=gpt-4o-mini
